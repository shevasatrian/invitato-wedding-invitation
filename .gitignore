# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# asset pack mentah dari Invitato (~19 MB PNG).
# Yang dipakai aplikasi adalah hasil optimasi di /public/images (WebP, ~2 MB),
# dibuat ulang kapan saja dengan: npm run optimize-images
/assets

# contoh env boleh ikut ter-commit (isinya placeholder, bukan kredensial asli)
!.env.example

# Tooling Claude Code — bukan bagian dari aplikasi
/.claude
/skills-lock.json

# PRD internal Invitato. Sengaja tidak di-publish ke repo publik,
# sejalan dengan catatan lisensi di dokumennya sendiri.
*.docx
